{
  // opencode の Global 設定（~/.config/opencode/opencode.json）
  //
  // opencode-with-strict-privacy の推奨グローバル設定と、Switchyard ルーターの
  // 接続設定をマージ済みの完成形です。Global 設定が未作成、または strict-privacy
  // の推奨構成のままで運用している場合は、このファイルでそのまま上書きできます。
  // 独自のカスタム設定（theme・他プロバイダ等）がある場合は README の
  // 「マージ」手順に従ってください。
  //
  // opencode は JSONC（コメント付き JSON）を正式サポートしているため、
  // コメントは消さずにそのまま保存して問題ありません。
  "$schema": "https://opencode.ai/config.json",

  // --- opencode-with-strict-privacy の推奨グローバル設定 ---
  // https://github.com/cm-dyoshikawa/opencode-with-strict-privacy/blob/main/README.ja.md
  // 環境変数側の設定（OPENCODE_ENABLE_EXA=0 等）はこのファイルには含まれない。
  // シェル rc（~/.zshrc 等）への設定を別途済ませること。

  // 会話の共有リンク生成を無効化
  "share": "disabled",
  // 自動アップデートを無効化
  "autoupdate": false,
  "tools": {
    // websearch は Exa/Parallel のホステッド MCP へ検索クエリを送るため無効化
    "websearch": false,
    "codesearch": false
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "ask"
  },

  // --- Switchyard ルーター（本バンドル） ---
  "provider": {
    "switchyard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard (Fireworks auto-routing)",
      "options": {
        "baseURL": "http://127.0.0.1:4100/v1",
        // ルーターはキーを検証しないためダミーで良い。
        // Fireworks の実キーはコンテナ側の .env にだけ置く。
        "apiKey": "local-dummy"
      },
      "models": {
        "auto": { "name": "auto — Switchyard routing" },
        "strong-only": { "name": "strong-only — deepseek-v4-pro pinned" },
        "weak-only": { "name": "weak-only — deepseek-v4-flash-0731 pinned" },
        // オプトイン。深い設計相談・プランニング用に手動で選ぶ。
        // コストは pro の約 7 倍（詳細は README「k3-only の使いどころ」）。
        "k3-only": { "name": "k3-only — kimi-k3 pinned (opt-in)" }
      }
    }
  },

  // 既定モデル = 自動ルーティング
  "model": "switchyard/auto",
  // タイトル生成などの補助コールは weak 固定（auto だと strong に化けることがある）
  "small_model": "switchyard/weak-only"

  // plan モードだけ K3 に固定したい場合は、次を追加する。
  // explore / scout にも明示指定するのは、opencode のサブエージェントが
  // 呼び出し元のモデルを継承するため（省くと grep 結果の読み取りにも
  // $15/1M の output 単価が乗る）。
  //
  // ,"agent": {
  //   "plan": { "model": "switchyard/k3-only" },
  //   "explore": { "model": "switchyard/weak-only" },
  //   "scout": { "model": "switchyard/weak-only" }
  // }
}
