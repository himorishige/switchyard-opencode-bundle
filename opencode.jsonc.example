{
  // opencode global config (~/.config/opencode/opencode.json)
  //
  // This is a ready-to-use merge of the recommended global settings from
  // opencode-with-strict-privacy and the connection settings for the Switchyard
  // router. If you have no global config yet, or you are running the
  // strict-privacy recommendations unmodified, you can copy this file over it
  // as-is. If you have your own customizations (theme, other providers, ...),
  // follow the "merge" instructions in the README instead.
  //
  // opencode officially supports JSONC (JSON with comments), so you can keep
  // these comments in the saved file.
  "$schema": "https://opencode.ai/config.json",

  // --- recommended global settings from opencode-with-strict-privacy ---
  // https://github.com/cm-dyoshikawa/opencode-with-strict-privacy
  // The environment-variable half (OPENCODE_ENABLE_EXA=0 and friends) is not
  // part of this file. Set those in your shell rc (~/.zshrc etc.) separately.

  // Disable generation of shareable conversation links
  "share": "disabled",
  // Disable automatic updates
  "autoupdate": false,
  "tools": {
    // websearch sends queries to the hosted Exa/Parallel MCP, so it is disabled
    "websearch": false,
    "codesearch": false
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "ask"
  },

  // --- Switchyard router (this bundle) ---
  "provider": {
    "switchyard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard (Fireworks auto-routing)",
      "options": {
        "baseURL": "http://127.0.0.1:4100/v1",
        // The router does not validate the key, so a dummy value is fine.
        // The real Fireworks key lives only in the container's .env.
        "apiKey": "local-dummy"
      },
      "models": {
        "auto": { "name": "auto — Switchyard routing" },
        // Opt-in: weak-first with evidence-based escalation to strong (latches
        // per session after a clear pattern of trouble). Buffered streaming
        // until the latch — see README "Evidence-based escalation".
        "auto-esc": { "name": "auto-esc — weak-first, escalates on trouble" },
        // `modalities` is what makes opencode send an image at all: without it
        // an attachment is dropped and the model answers "I cannot read
        // images", however capable the upstream model is. Kimi K3 reads
        // images, so both routes that pin it declare the input modality.
        "strong-only": {
          "name": "strong-only — kimi-k3 pinned",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        // Deliberately NO modalities on auto / auto-esc / weak-only: the weak
        // tier (deepseek-v4-flash-0731) rejects image input outright. Declaring
        // it there would let opencode send a screenshot into a session already
        // pinned to weak, which fails with an upstream 400. Attach images on
        // strong-only / k3-only instead.
        "weak-only": { "name": "weak-only — deepseek-v4-flash-0731 pinned" },
        // Since strong moved to K3 on 2026-08-07 this points at the same
        // target as strong-only. Kept as an alias so existing configs that
        // reference it keep working.
        "k3-only": {
          "name": "k3-only — kimi-k3 pinned (alias of strong-only)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },

  // Default model = automatic routing
  "model": "switchyard/auto",
  // Auxiliary calls such as title generation are pinned to weak
  // (through auto they occasionally turn into strong calls)
  "small_model": "switchyard/weak-only",

  // Per-agent pinning, enabled by default now that strong is K3 ($15/1M output).
  // - plan: wired straight to strong (Kimi K3). The classifier's capability
  //   rubric is written around coding work, so deep non-code discussions fall
  //   to a probabilistic threshold (most reach strong, not all). Design
  //   conversations should be deterministic, not a bet on the classifier
  // - explore / scout: subagents inherit the model of whatever called them, so
  //   pinning weak explicitly cuts the inheritance. Without it, work as simple
  //   as reading grep output is billed at K3's output rate
  "agent": {
    "plan": { "model": "switchyard/strong-only" },
    "explore": { "model": "switchyard/weak-only" },
    "scout": { "model": "switchyard/weak-only" }
  }
}
