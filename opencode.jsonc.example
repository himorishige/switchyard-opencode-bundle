{
  // opencode global config (~/.config/opencode/opencode.json)
  //
  // This is a ready-to-use merge of the recommended global settings from
  // opencode-with-strict-privacy and the connection settings for the Switchyard
  // router. If you have no global config yet, or you are running the
  // strict-privacy recommendations unmodified, you can copy this file over it
  // as-is. If you have your own customizations (theme, other providers, ...),
  // follow the "merge" instructions in the README instead.
  //
  // opencode officially supports JSONC (JSON with comments), so you can keep
  // these comments in the saved file.
  "$schema": "https://opencode.ai/config.json",

  // --- recommended global settings from opencode-with-strict-privacy ---
  // https://github.com/cm-dyoshikawa/opencode-with-strict-privacy
  // The environment-variable half (OPENCODE_ENABLE_EXA=0 and friends) is not
  // part of this file. Set those in your shell startup file (~/.zshrc, or ~/.bashrc for bash) separately.

  // Disable generation of shareable conversation links
  "share": "disabled",
  // Disable automatic updates
  "autoupdate": false,
  "tools": {
    // websearch sends queries to the hosted Exa/Parallel MCP, so it is disabled
    "websearch": false,
    "codesearch": false
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "ask",
    // Never-run commands regardless of auto mode. This is the deterministic
    // half of the guard; the content-aware half (homographs, pipe-to-shell,
    // credential leaks, ...) is handled by the tirith-guard plugin below.
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      // catch-all: anything not matched above asks for approval
      "*": "ask",
      // policy-level prohibitions — stay deny even when auto mode approves
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fdx*": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny"
    }
  },

  // --- tirith-guard plugin (optional but recommended) ---
  // Guards every `bash` tool call with Tirith before it runs: blocks on
  // findings at/above HIGH severity (homographs, pipe-to-shell, data
  // exfiltration, credential leaks, ...). Fail-open by default — if tirith is
  // not installed the plugin just logs a warn and lets the command through.
  //   1. Install tirith once:  brew install sheeki03/tap/tirith
  //   2. Point this at your clone of the bundle repo:
  // "plugin": [
  //   "file:///absolute/path/to/switchyard-opencode-bundle/plugin/tirith-guard/index.ts"
  // ],
  // Tune via env vars in your shell profile: TIRITH_GUARD_SEVERITY (HIGH),
  // TIRITH_GUARD_TIMEOUT_MS (5000), TIRITH_GUARD_FAIL_MODE (open|closed),
  // TIRITH_BIN. See plugin/tirith-guard/README.md.
  // OpenCode 2 (opencode2, beta) cannot load this v1 plugin; it has its own
  // build at plugin/tirith-guard/v2.ts — see opencode.v2.jsonc.example.

  // --- Switchyard router (this bundle) ---
  "provider": {
    "switchyard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard (Fireworks auto-routing)",
      "options": {
        "baseURL": "http://127.0.0.1:4100/v1",
        // The router does not validate the key, so a dummy value is fine.
        // The real Fireworks key lives only in the container's .env.
        "apiKey": "local-dummy"
      },
      // Every route declares `tool_call` and `modalities` explicitly. This
      // matters because opencode 1.x and OpenCode 2 (opencode2, beta) fill in
      // opposite defaults for a custom model that says nothing:
      //   - opencode 1.x: no `modalities` = text-only (images are dropped)
      //   - opencode2:    no capabilities = tools + text + IMAGE input, and a
      //                   `modalities`-only entry is read as tool_call: false
      // Left implicit, opencode2 would send screenshots to the text-only tiers
      // (upstream 400) and disable tool calling on k3-only. Declaring the real
      // capabilities keeps this one file correct on both versions.
      "models": {
        "auto": {
          "name": "auto — Switchyard routing",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        // Opt-in: weak-first with evidence-based escalation to strong (latches
        // per session after a clear pattern of trouble). Buffered streaming
        // until the latch — see README "Evidence-based escalation".
        "auto-esc": {
          "name": "auto-esc — weak-first, escalates on trouble",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        // Text-only on purpose: deepseek-v4-pro-0813 rejects image input.
        // Declaring image here would let opencode send a screenshot upstream,
        // which fails with a 400. Attach images on k3-only instead.
        "strong-only": {
          "name": "strong-only — deepseek-v4-pro-0813 pinned",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        // Text-only on auto / auto-esc / weak-only as well: the weak tier
        // (deepseek-v4-flash-0731) rejects image input outright. Declaring
        // image there would let opencode send a screenshot into a session
        // already pinned to weak, which fails with an upstream 400.
        "weak-only": {
          "name": "weak-only — deepseek-v4-flash-0731 pinned",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        // Kimi K3, pinned — its own target since strong moved to
        // deepseek-v4-pro-0813 (2026-08-14). The plan agent points here, and
        // this is the manual lane for image attachments: the image modality is
        // what makes opencode send an image at all — without it an attachment
        // is dropped and the model answers "I cannot read images", however
        // capable the upstream model is. Kimi K3 reads images.
        "k3-only": {
          "name": "k3-only — kimi-k3 pinned (plan/vision)",
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },

  // Default model = automatic routing
  "model": "switchyard/auto",
  // Auxiliary calls such as title generation are pinned to weak
  // (through auto they occasionally turn into strong calls)
  "small_model": "switchyard/weak-only",

  // Per-agent pinning, enabled by default.
  // - plan: wired straight to Kimi K3 (k3-only) for sparring/planning quality.
  //   The classifier's capability rubric is written around coding work, so deep
  //   non-code discussions fall to a probabilistic threshold (most reach
  //   strong, not all). Design conversations should be deterministic, not a
  //   bet on the classifier — and they stay on K3 even though the strong tier
  //   moved to deepseek-v4-pro-0813
  // - explore / scout: subagents inherit the model of whatever called them, so
  //   pinning weak explicitly cuts the inheritance. Without it, work as simple
  //   as reading grep output is billed at K3's output rate ($15/1M)
  "agent": {
    "plan": { "model": "switchyard/k3-only" },
    "explore": { "model": "switchyard/weak-only" },
    "scout": { "model": "switchyard/weak-only" }
  }
}
