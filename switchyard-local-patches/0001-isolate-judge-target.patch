+    /// Internal judge aliases select distinct clients but never reach provider calls or observations.
+    #[tokio::test]
+    async fn side_call_alias_preserves_upstream_model_in_observations() -> Result<()> {
+        let judge = Arc::new(CandidateClient {
+            calls: Mutex::new(Vec::new()),
+            requests: Mutex::new(Vec::new()),
+            first: FirstOutcome::StreamSuccess,
+        });
+        let answer = Arc::new(CandidateClient {
+            calls: Mutex::new(Vec::new()),
+            requests: Mutex::new(Vec::new()),
+            first: FirstOutcome::StreamSuccess,
+        });
+        let router = ClientRouter::new(HashMap::from([
+            (
+                ModelId::from("internal-judge"),
+                judge.clone() as Arc<dyn RoutedLlmClient>,
+            ),
+            (
+                ModelId::from("weak"),
+                answer.clone() as Arc<dyn RoutedLlmClient>,
+            ),
+        ]))
+        .with_model_aliases(HashMap::from([(
+            ModelId::from("internal-judge"),
+            ModelId::from("weak"),
+        )]));
+        let observations = Mutex::new(Vec::new());
+        let observe =
+            |observation: LlmCallObservation| observations.lock().push(observation.selected_model);
+        let response = call_first_available(
+            &router,
+            "test",
+            &request(),
+            &[ModelId::from("internal-judge")],
+            CallPhase::Routing,
+            &observe,
+        )
+        .await?;
+        assert_eq!(response.served_model(), Some(&ModelId::from("weak")));
+        assert_eq!(*judge.calls.lock(), [ModelId::from("weak")]);
+        assert!(answer.calls.lock().is_empty());
+        assert_eq!(*observations.lock(), [ModelId::from("weak")]);
+        Ok(())
+    }
