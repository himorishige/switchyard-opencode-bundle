+    /// Resolve internal side-call identities to provider model names before transport.
+    /// Aliases must not name answer destinations, whose IDs are public decisions.
+    pub fn with_model_aliases(mut self, aliases: HashMap<ModelId, ModelId>) -> Self {
+        self.inner = Arc::new(ClientRouting {
+            routing: match &self.inner.routing {
+                Routing::Single(client) => Routing::Single(client.clone()),
+                Routing::ByModel(models) => Routing::ByModel(models.clone()),
+            },
+            target_prompts: self.inner.target_prompts.clone(),
+            routing_answer_target: self.inner.routing_answer_target.clone(),
+            model_aliases: aliases,
+        });
+        self
+    }
+
+    fn upstream_model<'a>(&'a self, target: &'a ModelId) -> &'a ModelId {
+        self.inner.model_aliases.get(target).unwrap_or(target)
+    }
