# Fireworks API key from the trial Org (keep the real .env chmod 600; never commit).
# Issue yours at: https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=fw-xxxxxxxxxxxxxxxx

# Local secret for the bundled SearXNG container (not an external key).
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
